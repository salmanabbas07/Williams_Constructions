# Williams Constructions - Production Apache / LiteSpeed Configuration
# Official Domain: https://williamsconstruction.si

# 1. Custom 404 Error Page
ErrorDocument 404 /404.html

# 2. Disable mod_dir automatic trailing-slash directory redirects
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 3. Canonical HTTPS & Host (Force HTTPS and non-www)
    # Skip POST requests so API calls aren't broken
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://williamsconstruction.si%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://williamsconstruction.si%{REQUEST_URI} [R=301,L]

    # 4. Preserve backend PHP API directory without any rewrites
    RewriteRule ^backend(/.*)?$ - [L]

    # 5. Fix Duplicate Slashes (// -> / or /about// -> /about)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/{2,}[?\s] [NC]
    RewriteRule ^ / [R=301,L]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)//+[?\s] [NC]
    RewriteRule ^ /%1 [R=301,L]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)//+(.+?)[?\s] [NC]
    RewriteRule ^ /%1/%2 [R=301,L]

    # 6. Canonical Index Page Redirects (/index.html, /index.php -> /)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.(html|php)[?\s] [NC]
    RewriteRule ^ / [R=301,L]

    # Subdirectory index redirects (/about/index.html -> /about)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)/index\.(html|php)[?\s] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 7. Canonical Trailing Slash Enforcement:
    # Non-root paths with trailing slashes (e.g. /about/ -> /about) 301 redirect
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)/+[?\s] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 8. Canonical Legacy URL Aliases
    RewriteRule ^industries/?$ /projects [R=301,L,NC]
    RewriteRule ^pogosta-vprasanja/?$ /faq [R=301,L,NC]
    RewriteCond %{THE_REQUEST} \s/+Pogosta(%20|\s)+vpra(%C5%A1|%C5%A0|š|Š)anja/?[\s?] [NC]
    RewriteRule ^ /faq [R=301,L]

    # 9. Serve Homepage directly for root
    DirectoryIndex index.html
    RewriteRule ^$ index.html [L]

    # 10. Serve pre-rendered HTML for clean routes (e.g. /about -> /about/index.html)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+)$ $1/index.html [L]

    # 11. Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 12. Return true HTTP 404 status for all unknown routes
    RewriteRule ^ - [R=404,L]
</IfModule>

# Compression (GZIP) for fast mobile delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Aggressive caching for hashed Vite assets & static images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
