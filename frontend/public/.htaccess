# Williams Constructions - Frontend Production Apache / LiteSpeed Configuration
ErrorDocument 404 /404.html

# Prevent directory trailing-slash redirects on pre-rendered route directories (/about -> /about/)
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS + canonical non-www host (skip POST so API payloads stay intact)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://williamsconstruction.si%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://williamsconstruction.si%{REQUEST_URI} [R=301,L]

    # 2. Preserve existing backend PHP API directory without rewriting
    RewriteRule ^backend(/.*)?$ - [L]

    # 3. Canonical 301 redirects for legacy alias URLs
    RewriteRule ^industries/?$ /projects [R=301,L,NC]
    RewriteRule ^pogosta-vprasanja/?$ /faq [R=301,L,NC]
    RewriteCond %{THE_REQUEST} \s/+Pogosta(%20|\s)+vpra(%C5%A1|%C5%A0|š|Š)anja/?[\s?] [NC]
    RewriteRule ^ /faq [R=301,L]

    # 4. Enforce no trailing slash on non-root URLs (/about/ -> 301 /about)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # 5. Serve pre-rendered HTML for clean routes (e.g. /about -> /about/index.html)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+)$ $1/index.html [L]

    # 6. Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 7. Unknown routes return real HTTP 404 status with pre-rendered 404.html
    RewriteRule ^ - [R=404,L]
</IfModule>

# Compression (GZIP) for faster mobile delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Aggressive caching for hashed Vite assets & static images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
