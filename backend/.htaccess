# ==============================================================================
# Wilma Construction - Backend Apache Security Configuration (.htaccess)
# Designed for Hostinger Shared Hosting & Apache / LiteSpeed web servers
# ==============================================================================

# 1. Disable directory browsing for privacy and security
Options -Indexes

# 2. Block access to hidden files and directories (e.g. .git, .env, .htaccess)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Block access to configuration files, lock files, logs, and sensitive extensions
<FilesMatch "\.(json|lock|md|log|ini|env|example|bak|sql|sh)$">
    Require all denied
</FilesMatch>

# 4. Block direct web access to sensitive subdirectories (config, vendor, helpers, controllers)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|vendor|helpers|controllers)/ - [F,L]
</IfModule>

# 5. Fallback authorization header passing for fastcgi/php-fpm
<IfModule mod_rewrite.c>
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# 6. Default charset
AddDefaultCharset UTF-8
